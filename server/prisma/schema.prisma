generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  notes   Note[]
  diaryEntries DiaryEntry[]
  diaryPinHash  String?
  profilePicture String?
  handwritingSamples HandwritingSample[]
}

model PendingRegistration {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String

  otpHash        String
  otpExpiresAt   DateTime
  otpAttempts    Int      @default(0)
  otpSentAt      DateTime @default(now())

  createdAt      DateTime @default(now())
}

model PasswordReset {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  otpHash      String
  otpExpiresAt DateTime
  otpAttempts  Int      @default(0)
  otpSentAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  verifiedAt DateTime?
}
model AccountPasswordChange {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  otpHash      String
  otpExpiresAt DateTime
  otpAttempts  Int      @default(0)
  otpSentAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  verifiedAt   DateTime?
}
model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isFavourite Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiaryEntry {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos    DiaryPhoto[]
}

model DiaryPhoto {
  id           Int        @id @default(autoincrement())
  imageUrl     String
  createdAt    DateTime   @default(now())

  diaryEntryId Int
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
}
model DiaryPinReset {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  otpHash      String
  otpExpiresAt DateTime
  otpAttempts  Int      @default(0)
  otpSentAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  verifiedAt   DateTime?
}
model HandwritingSample {
  id        Int      @id @default(autoincrement())

  character String
  imageData String   @db.Text
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, character])
}