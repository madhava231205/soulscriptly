generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  notes   Note[]
  diaryEntries DiaryEntry[]
  diaryPinHash  String?
  handwritingSamples HandwritingSample[]
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isFavourite Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiaryEntry {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos    DiaryPhoto[]
}

model DiaryPhoto {
  id           Int        @id @default(autoincrement())
  imageUrl     String
  createdAt    DateTime   @default(now())

  diaryEntryId Int
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
}

model HandwritingSample {
  id        Int      @id @default(autoincrement())

  character String
  imageData String   @db.Text
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, character])
}